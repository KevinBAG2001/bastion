# Base de datos PostgreSQL (local con docker-compose)
DATABASE_URL="postgresql://bastion:bastion_dev@localhost:5432/bastion?schema=public"

# Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto-en-produccion"

# Cifrado AES-256-GCM de secretos TOTP en reposo — genera con: openssl rand -base64 32
# Debe decodificar a exactamente 32 bytes. No reutilices AUTH_SECRET.
TOTP_ENCRYPTION_KEY="cambia-esta-clave-en-produccion-base64-32-bytes"

# URL pública de la app
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Entorno
NODE_ENV="development"
